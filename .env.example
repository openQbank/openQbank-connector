# Extension version used by `npm run sync:version` and build scripts.
VERSION=13.3.3

# Chrome Web Store API credentials for `npm run publish:cws`
# Copy to `.env` and fill in the OAuth values from Google Cloud Console.

# Published extension ID (Chrome Web Store → openQbank Connector)
CHROME_EXTENSION_ID=dgajpjanpcdochcadolmgdoeddckpnli

# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Desktop app)
CHROME_CLIENT_ID=your-client-id.apps.googleusercontent.com
CHROME_CLIENT_SECRET=your-client-secret

# One-time refresh token from OAuth 2.0 Playground
# Scope: https://www.googleapis.com/auth/chromewebstore
CHROME_REFRESH_TOKEN=your-refresh-token

# GitHub Actions uses the same four names as repository/environment secrets.
# Store the client secret and refresh token only in GitHub Secrets or this ignored file.
# The release workflow uses the protected `chrome-web-store` environment.

# Alternate key names supported by scripts/publish-cws.mjs:
# EXTENSION_ID=
# CLIENT_ID=
# CLIENT_SECRET=
# REFRESH_TOKEN=
