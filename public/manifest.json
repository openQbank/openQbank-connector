{
    "manifest_version": 3,
    "name": "openQbank Connector",
    "version": "14.1.7",
    "description": "Turn anything into targeted flashcards. Free and open-source.",
    "permissions": [
        "activeTab",
        "storage",
        "contextMenus",
        "scripting"
    ],
    "icons": {
        "128": "logo.png"
    },
    "host_permissions": [
        "https://api.openai.com/*",
        "<all_urls>"
    ],
    "action": {
        "default_title": "openQbank Connector",
        "default_icon": "logo.png",
        "default_popup": "index.html"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        },
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "selection.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "logo.png"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
