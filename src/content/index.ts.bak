const sendOpenQBankRequest = async <T = void>(
    path: string,
    body?: Record<string, unknown>,
    expectData = false,
    method: 'GET' | 'POST' = 'POST',
) : Promise<T | null> => {
    if (!chrome?.runtime?.id) {
        throw new Error('Extension context invalidated. Please refresh the page.');
    }

    const response = await new Promise<OpenQBankWorkerResponse>((resolve, reject) => {
        try {
            chrome.runtime.sendMessage(
                {
                    type: 'openqbank_request',
                    request: {
                        path,
                        method,
                        body,
                    },
                },
                (messageResponse: OpenQBankWorkerResponse) => {
                    if (chrome.runtime.lastError) {
                        reject(new Error(chrome.runtime.lastError.message || 'Request failed.'));
                        return;
                    }

                    resolve(messageResponse);
                },
            );
        } catch (error) {
            reject(error instanceof Error ? error : new Error(String(error)));
        }
    });

    if (!response?.ok) {
        const dataObj = response?.data && typeof response.data === 'object' ? (response.data as Record<string, unknown>) : undefined;
        if (response?.status === 426 || dataObj?.code === 'UPGRADE_REQUIRED') {
            const minV = typeof dataObj?.min_version === 'string' ? dataObj.min_version : undefined;
            const upUrl = typeof dataObj?.upgrade_url === 'string' ? dataObj.upgrade_url : undefined;
            showUpdateRequiredModal(minV, upUrl);
        } else if (response?.status === 403 && dataObj?.code === 'HYGURU_UPGRADE_REQUIRED') {
            showHyGuruUpgradeModal();
        }
        throw new Error(response?.error || 'Request failed.');
    }

    return expectData ? (response.data as T) : null;
};

type GenerateCardsResponse = {
    queued?: boolean;
    already_cached?: boolean;
    question_id?: string;
    job_id?: number;
    message?: string;
    error?: string;
    cards?: string;
    content_scope?: HyGuruContentScope;
    locked_count?: number;
    user_owned?: boolean;
    generation_pending?: boolean;
    generation_failed?: boolean;
};

const requestGenerateCards = async (
    questionId?: string,
    questionData?: QuestionData | null,
): Promise<GenerateCardsResponse> => {
    return (await sendOpenQBankRequest<GenerateCardsResponse>(
        '/api/extension/generate-cards',
        {
            question_id: questionId?.trim() || questionData?.questionId?.trim() || '',
            question_data: buildQuestionDataPayload(questionData),
        },
        true,
    )) || {};
};

const requestLearningFlag = async (
    questionId?: string,
    questionData?: QuestionData | null,
) : Promise<LearningFlagResponse> => {
    return (await sendOpenQBankRequest<LearningFlagResponse>(
        '/api/extension/flag-learning',
        {
            question_id: questionId?.trim() || questionData?.questionId?.trim() || '',
            question_data: buildQuestionDataPayload(questionData),
        },
        true,
    )) || {};
};

const requestAddToLibrary = async (
    questionId: string,
    cardIndex?: number,
    questionData?: QuestionData | null,
) => {
    return await sendOpenQBankRequest<{ success: boolean; cards_count?: number }>(
        '/api/extension/add-to-library',
        {
            question_id: questionId.trim(),
            card_index: cardIndex != null ? cardIndex : undefined,
            question_data: buildQuestionDataPayload(questionData),
        },
        true,
    );
};

const requestReportCard = async (payload: {
    questionId: string;
    cardIndex: number;
    rating?: string;
    issues?: string[];
    comment?: string;
    platform?: string;
    cardFront?: string;
    cardBack?: string;
    topic?: string;
}) => {
    return await sendOpenQBankRequest<{ success: boolean }>(
        '/api/extension/report-card',
        {
            question_id: payload.questionId.trim(),
            card_index: payload.cardIndex,
            rating: payload.rating || 'needs_work',
            issues: payload.issues || [],
            feedback_text: payload.comment || '',
            platform: payload.platform || getPlatformFromLocation(),
            card_front: payload.cardFront || '',
            card_back: payload.cardBack || '',
            topic: payload.topic || '',
        },
        true,
    );
};

